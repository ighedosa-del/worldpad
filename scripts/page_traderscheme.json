    "html": "<html lang=\"en\" dir=\"ltr\"><head><style>\n        :root {\n            color-scheme: dark;\n        }\n\n        * {\n            box-sizing: border-box;\n        }\n\n        html, body {\n            background: #120606;\n            margin: 0;\n            min-height: 100%;\n            overflow: hidden;\n        }\n\n        body {\n            font-family: \"Segoe UI\", \"Trebuchet MS\", system-ui, sans-serif;\n        }\n\n        .bt-shield {\n            align-items: center;\n            background:\n                radial-gradient(circle at 18% 20%, rgba(239, 68, 68, 0.2), transparent 28%),\n                radial-gradient(circle at 82% 18%, rgba(249, 115, 22, 0.16), transparent 24%),\n                radial-gradient(circle at 50% 100%, rgba(220, 38, 38, 0.18), transparent 40%),\n                linear-gradient(160deg, #120606 0%, #1f0b0b 46%, #2a0f0f 100%);\n            color: #f8fafc;\n            display: grid;\n            min-height: 100vh;\n            overflow: hidden;\n            padding: 24px;\n            place-items: center;\n            position: relative;\n        }\n\n        .bt-shield::before {\n            background:\n                linear-gradient(90deg, rgba(255, 245, 245, 0.04) 1px, transparent 1px),\n                linear-gradient(180deg, rgba(255, 230, 230, 0.03) 1px, transparent 1px);\n            background-size: 36px 36px;\n            content: \"\";\n            inset: 0;\n            opacity: 0.16;\n            pointer-events: none;\n            position: absolute;\n        }\n\n        .bt-shield__orb {\n            border-radius: 999px;\n            filter: blur(24px);\n            pointer-events: none;\n            position: absolute;\n        }\n\n        .bt-shield__orb--one {\n            animation: bt-float 10s ease-in-out infinite;\n            background: rgba(239, 68, 68, 0.24);\n            height: 14rem;\n            left: 8%;\n            top: 12%;\n            width: 14rem;\n        }\n\n        .bt-shield__orb--two {\n            animation: bt-float 12s ease-in-out infinite reverse;\n            background: rgba(249, 115, 22, 0.18);\n            bottom: 12%;\n            height: 16rem;\n            right: 10%;\n            width: 16rem;\n        }\n\n        .bt-shield__card {\n            animation: bt-rise 0.8s ease-out;\n            backdrop-filter: blur(18px);\n            background: linear-gradient(180deg, rgba(34, 10, 10, 0.9), rgba(24, 8, 8, 0.8));\n            border: 1px solid rgba(248, 113, 113, 0.16);\n            border-radius: 30px;\n            box-shadow:\n                0 28px 90px rgba(12, 2, 2, 0.6),\n                0 0 44px rgba(127, 29, 29, 0.22),\n                inset 0 1px 0 rgba(255, 245, 245, 0.05);\n            max-width: 680px;\n            padding: 36px 32px 28px;\n            position: relative;\n            text-align: center;\n            width: min(100%, 680px);\n            z-index: 1;\n        }\n\n        .bt-shield__line {\n            background: linear-gradient(90deg, #dc2626, #f97316, #dc2626);\n            border-radius: 999px;\n            height: 4px;\n            margin: 0 auto 1.25rem;\n            width: 88px;\n        }\n\n        .bt-shield__status {\n            align-items: center;\n            animation: bt-status-pulse 1.4s ease-in-out infinite;\n            background: rgba(36, 10, 10, 0.78);\n            border: 1px solid rgba(248, 113, 113, 0.38);\n            border-radius: 999px;\n            color: #fee2e2;\n            display: inline-flex;\n            font-size: 0.8rem;\n            font-weight: 700;\n            gap: 0.55rem;\n            letter-spacing: 0.08em;\n            padding: 0.7rem 1rem;\n            text-transform: uppercase;\n        }\n\n        .bt-shield__status-dot {\n            background: #fb7185;\n            border-radius: 999px;\n            box-shadow: 0 0 16px rgba(251, 113, 133, 0.85);\n            height: 0.6rem;\n            width: 0.6rem;\n        }\n\n        .bt-shield__badge {\n            align-items: center;\n            background: rgba(153, 27, 27, 0.24);\n            border: 1px solid rgba(248, 113, 113, 0.3);\n            border-radius: 999px;\n            color: #fecaca;\n            display: inline-flex;\n            font-size: 0.78rem;\n            font-weight: 700;\n            gap: 0.45rem;\n            letter-spacing: 0.08em;\n            margin-top: 1rem;\n            padding: 0.65rem 1rem;\n            text-transform: uppercase;\n        }\n\n        .bt-shield__title {\n            font-size: clamp(2rem, 6vw, 3.3rem);\n            font-weight: 900;\n            letter-spacing: -0.045em;\n            line-height: 0.95;\n            margin: 1.25rem 0 0;\n            text-shadow: 0 12px 30px rgba(220, 38, 38, 0.18);\n        }\n\n        .bt-shield__lead {\n            color: #e5e7eb;\n            font-size: 1.03rem;\n            line-height: 1.75;\n            margin: 1rem auto 0;\n            max-width: 38rem;\n        }\n\n        .bt-shield__alarm-note {\n            color: #fdba74;\n            font-size: 0.9rem;\n            font-weight: 700;\n            letter-spacing: 0.02em;\n            margin: 1.1rem 0 0;\n        }\n\n        .bt-shield__divider {\n            background: linear-gradient(90deg, transparent, rgba(248, 113, 113, 0.24), transparent);\n            height: 1px;\n            margin: 1.5rem auto 1.15rem;\n            width: min(100%, 24rem);\n        }\n\n        .bt-shield__footer {\n            color: #fca5a5;\n            font-size: 0.88rem;\n            margin: 0 0 1rem;\n        }\n\n        .bt-shield__socials {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 0.75rem;\n            justify-content: center;\n        }\n\n        .bt-shield__social {\n            align-items: center;\n            background: rgba(28, 10, 10, 0.82);\n            border: 1px solid rgba(248, 113, 113, 0.14);\n            border-radius: 16px;\n            color: #f8fafc;\n            display: inline-flex;\n            font-size: 0.94rem;\n            font-weight: 700;\n            gap: 0.6rem;\n            padding: 0.85rem 1rem;\n            text-decoration: none;\n            transition:\n                transform 0.2s ease,\n                border-color 0.2s ease,\n                background 0.2s ease;\n        }\n\n        .bt-shield__social:hover {\n            background: rgba(69, 10, 10, 0.92);\n            border-color: rgba(249, 115, 22, 0.4);\n            transform: translateY(-2px);\n        }\n\n        .bt-shield__social-icon {\n            align-items: center;\n            background: rgba(239, 68, 68, 0.14);\n            border-radius: 12px;\n            display: inline-flex;\n            font-size: 1.1rem;\n            height: 2.1rem;\n            justify-content: center;\n            width: 2.1rem;\n        }\n\n        @keyframes bt-rise {\n            from {\n                opacity: 0;\n                transform: translateY(18px) scale(0.985);\n            }\n\n            to {\n                opacity: 1;\n                transform: translateY(0) scale(1);\n            }\n        }\n\n        @keyframes bt-float {\n            0%,\n            100% {\n                transform: translate3d(0, 0, 0) scale(1);\n            }\n\n            50% {\n                transform: translate3d(0, -18px, 0) scale(1.04);\n            }\n        }\n\n        @keyframes bt-status-pulse {\n            0%,\n            100% {\n                box-shadow: 0 0 0 rgba(248, 113, 113, 0);\n                opacity: 0.88;\n            }\n\n            50% {\n                box-shadow: 0 0 28px rgba(248, 113, 113, 0.24);\n                opacity: 1;\n            }\n        }\n    </style>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/static/css/async/300.24368415.css\"><link rel=\"stylesheet\" type=\"text/css\" href=\"/static/css/async/802.415994cc.css\"><script async=\"\" src=\"https://static.hotjar.com/c/hotjar-3050531.js?sv=6\"></script><script async=\"\" src=\"https://script.hotjar.com/modules.75bf3488a101739acfe9.js\" charset=\"utf-8\"></script></head><body class=\"theme--light\"><div class=\"bt-shield\">\n        <div class=\"bt-shield__orb bt-shield__orb--one\"></div>\n        <div class=\"bt-shield__orb bt-shield__orb--two\"></div>\n        <main class=\"bt-shield__card\">\n            <div class=\"bt-shield__line\"></div>\n            <div class=\"bt-shield__status\" role=\"alert\" aria-live=\"assertive\">\n                <span class=\"bt-shield__status-dot\"></span>\n                <span>Access restricted</span>\n            </div>\n            <div class=\"bt-shield__badge\">⚠️ Workspace Danger Shield</div>\n            <h1 class=\"bt-shield__title\">Restricted danger zone</h1>\n            <p class=\"bt-shield__lead\">\n                Developer tools are blocked on this workspace. Close inspection tools and reload the page to continue.\n            </p>\n            <p class=\"bt-shield__alarm-note\" id=\"bt-shield-alarm-note\">Alarm siren arming...</p>\n            <div class=\"bt-shield__divider\"></div>\n            <p class=\"bt-shield__footer\">Follow our channels</p>\n            <div class=\"bt-shield__socials\">\n                <a class=\"bt-shield__social\" href=\"https://www.instagram.com/binarytoolsite/\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    <span class=\"bt-shield__social-icon\">📸</span>\n                    <span>Instagram</span>\n                </a>\n                <a class=\"bt-shield__social\" href=\"https://whatsapp.com/channel/0029VaDbybILo4heuWEGso3B\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    <span class=\"bt-shield__social-icon\">💬</span>\n                    <span>WhatsApp</span>\n                </a>\n                <a class=\"bt-shield__social\" href=\"https://www.tiktok.com/@binarytools\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    <span class=\"bt-shield__social-icon\">🎵</span>\n                    <span>TikTok</span>\n                </a>\n                <a class=\"bt-shield__social\" href=\"https://t.me/binarytools\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    <span class=\"bt-shield__social-icon\">✈️</span>\n                    <span>Telegram</span>\n                </a>\n            </div>\n        </main>\n    </div>\n    <script>\n        (function () {\n            var AudioContextClass = window.AudioContext || window.webkitAudioContext;\n            var alarmNote = document.getElementById('bt-shield-alarm-note');\n            var hasStarted = false;\n            var audioContext;\n            var masterGain;\n            var loopTimer = 0;\n\n            function setAlarmNote(text) {\n                if (alarmNote) {\n                    alarmNote.textContent = text;\n                }\n            }\n\n            function createSirenTone(startTime, frequency, duration) {\n                if (!audioContext || !masterGain) {\n                    return;\n                }\n\n                var oscillator = audioContext.createOscillator();\n                var gainNode = audioContext.createGain();\n\n                oscillator.type = 'sine';\n                oscillator.frequency.setValueAtTime(frequency, startTime);\n                oscillator.frequency.linearRampToValueAtTime(frequency * 1.12, startTime + duration * 0.5);\n                oscillator.frequency.linearRampToValueAtTime(frequency * 0.94, startTime + duration);\n\n                gainNode.gain.setValueAtTime(0.0001, startTime);\n                gainNode.gain.exponentialRampToValueAtTime(0.08, startTime + 0.05);\n                gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);\n\n                oscillator.connect(gainNode);\n                gainNode.connect(masterGain);\n\n                oscillator.start(startTime);\n                oscillator.stop(startTime + duration + 0.03);\n            }\n\n            function scheduleAlarmLoop() {\n                if (!audioContext || !masterGain) {\n                    return;\n                }\n\n                var now = audioContext.currentTime + 0.03;\n\n                createSirenTone(now, 560, 0.42);\n                createSirenTone(now + 0.48, 760, 0.42);\n\n                loopTimer = window.setTimeout(scheduleAlarmLoop, 1200);\n            }\n\n            function startAlarm() {\n                if (hasStarted || !AudioContextClass) {\n                    return;\n                }\n\n                audioContext = new AudioContextClass();\n                masterGain = audioContext.createGain();\n                masterGain.gain.value = 0.16;\n                masterGain.connect(audioContext.destination);\n\n                hasStarted = true;\n                setAlarmNote('Alarm siren active');\n\n                if (audioContext.state === 'suspended') {\n                    audioContext.resume().then(scheduleAlarmLoop).catch(function () {\n                        setAlarmNote('Tap anywhere to activate the alarm siren');\n                        hasStarted = false;\n                    });\n                    return;\n                }\n\n                scheduleAlarmLoop();\n            }\n\n            function tryResumeAlarm() {\n                if (!AudioContextClass) {\n                    setAlarmNote('Audio warning is not supported on this browser');\n                    return;\n                }\n\n                if (!hasStarted) {\n                    startAlarm();\n                    return;\n                }\n\n                if (audioContext && audioContext.state === 'suspended') {\n                    audioContext.resume().then(function () {\n                        setAlarmNote('Alarm siren active');\n                        if (!loopTimer) {\n                            scheduleAlarmLoop();\n                        }\n                    });\n                }\n            }\n\n            window.addEventListener('pointerdown', tryResumeAlarm, { passive: true });\n            window.addEventListener('touchstart', tryResumeAlarm, { passive: true });\n            window.addEventListener('keydown', tryResumeAlarm);\n\n            tryResumeAlarm();\n        })();\n    </script>\n<iframe id=\"_hjSafeContext_36189961\" title=\"_hjSafeContext\" tabindex=\"-1\" aria-hidden=\"true\" src=\"about:blank\" style=\"display: none !important; width: 1px !important; height: 1px !important; opacity: 0 !important; pointer-events: none !important;\"></iframe></body></html>",
